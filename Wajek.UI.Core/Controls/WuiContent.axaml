<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Wajek.UI.Core.Controls"
             x:Class="Wajek.UI.Core.Controls.WuiContent"
             x:DataType="vm:WuiContent">

    <ContentControl Content="{Binding CurrentView, RelativeSource={RelativeSource AncestorType=vm:WuiContent}}"/>

</UserControl>
